generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  WAREHOUSE_STAFF
}

enum OperationType {
  RECEIPT
  DELIVERY
  INTERNAL
  ADJUSTMENT
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(WAREHOUSE_STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  operations Operation[] @relation("OperationResponsible")
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  shortCode String   @unique
  address   String?
  createdAt DateTime @default(now())

  locations Location[]
}

model Location {
  id          String    @id @default(uuid())
  name        String
  shortCode   String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now())

  stockLevels StockLevel[]
  movesFrom   StockMove[] @relation("MoveFromLocation")
  movesTo     StockMove[] @relation("MoveToLocation")

  @@unique([warehouseId, shortCode])
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  category      String
  unitOfMeasure String
  unitCost      Decimal  @db.Decimal(12, 2)
  reorderLevel  Int      @default(0)
  createdAt     DateTime @default(now())

  stockLevels StockLevel[]
  moveLines   MoveLine[]
  stockMoves  StockMove[]
}

model StockLevel {
  id         String @id @default(uuid())
  productId  String
  locationId String
  onHand     Int    @default(0)
  allocated  Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
}

model Operation {
  id            String          @id @default(uuid())
  reference     String          @unique
  type          OperationType
  status        OperationStatus @default(DRAFT)
  contact       String?
  scheduledDate DateTime?
  responsibleId String?
  responsible   User?           @relation("OperationResponsible", fields: [responsibleId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lines MoveLine[]
}

model MoveLine {
  id          String @id @default(uuid())
  operationId String
  productId   String
  quantity    Int

  operation Operation @relation(fields: [operationId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
}

model StockMove {
  id             String          @id @default(uuid())
  reference      String
  productId      String
  fromLocationId String?
  toLocationId   String?
  quantity       Int
  status         OperationStatus @default(DONE)
  timestamp      DateTime        @default(now())

  product      Product   @relation(fields: [productId], references: [id])
  fromLocation Location? @relation("MoveFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("MoveToLocation", fields: [toLocationId], references: [id])
}