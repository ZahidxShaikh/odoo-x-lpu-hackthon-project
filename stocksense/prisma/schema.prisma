generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  WAREHOUSE_STAFF
}

enum OperationType {
  RECEIPT
  DELIVERY
  INTERNAL
  ADJUSTMENT
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  passwordHash String
  role        Role         @default(WAREHOUSE_STAFF)
  emailVerifiedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  warehouses  Warehouse[]
  products    Product[]
  operations  Operation[]
  stockMoves  StockMove[]
  resetTokens ResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Warehouse {
  id        String     @id @default(uuid())
  userId    String
  name      String
  shortCode String
  address   String?
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([userId, shortCode])
  @@index([userId])
}

model Location {
  id          String      @id @default(uuid())
  warehouseId String
  name        String
  shortCode   String
  createdAt   DateTime    @default(now())

  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockLevels StockLevel[]
  movesFrom   StockMove[] @relation("MoveFromLocation")
  movesTo     StockMove[] @relation("MoveToLocation")

  @@unique([warehouseId, shortCode])
  @@index([warehouseId])
}

model Product {
  id            String       @id @default(uuid())
  userId        String
  name          String
  sku           String
  category      String
  unitOfMeasure String
  unitCost      Decimal      @default(0) @db.Decimal(12, 2)
  reorderLevel  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockLevels   StockLevel[]
  moveLines     MoveLine[]
  stockMoves    StockMove[]

  @@unique([userId, sku])
  @@index([userId, category])
}

model StockLevel {
  id         String   @id @default(uuid())
  productId  String
  locationId String
  onHand     Int      @default(0)
  allocated  Int      @default(0)

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
}

model Operation {
  id            String          @id @default(uuid())
  userId        String
  reference     String
  type          OperationType
  status        OperationStatus @default(DRAFT)
  contact       String?
  scheduledDate DateTime?
  fromLocationId String?
  toLocationId   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines         MoveLine[]
  stockMoves    StockMove[]

  @@unique([userId, reference])
  @@index([userId, type, status])
}

model MoveLine {
  id          String    @id @default(uuid())
  operationId String
  productId   String
  quantity    Int

  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@index([operationId])
}

model StockMove {
  id               String          @id @default(uuid())
  userId           String
  operationId      String?
  reference        String
  productId        String
  type             OperationType
  status           OperationStatus @default(DONE)
  fromLocationId   String?
  toLocationId     String?
  contact          String?
  quantity         Int
  previousQuantity Int?
  countedQuantity  Int?
  timestamp        DateTime        @default(now())

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation        Operation?      @relation(fields: [operationId], references: [id], onDelete: SetNull)
  product          Product         @relation(fields: [productId], references: [id])
  fromLocation     Location?       @relation("MoveFromLocation", fields: [fromLocationId], references: [id])
  toLocation       Location?       @relation("MoveToLocation", fields: [toLocationId], references: [id])

  @@index([userId, timestamp])
  @@index([productId])
}

model ResetToken {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  attemptCount Int    @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  attemptCount Int    @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}